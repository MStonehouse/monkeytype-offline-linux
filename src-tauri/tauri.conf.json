{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Monkeytype Offline",
  "version": "1.0.0",
  "identifier": "com.mstonehouse.monkeytypeoffline",
  "build": {
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Monkeytype Offline",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/icon.png"
    ],
    "category": "Education",
    "shortDescription": "Offline-focused Monkeytype typing practice for Linux.",
    "longDescription": "An unofficial offline-focused Linux desktop edition derived from the open-source Monkeytype typing test.",
    "license": "GPL-3.0",
    "licenseFile": "../LICENSE",
    "copyright": "Monkeytype contributors; offline desktop modifications \u00a9 2026 Mike Stonehouse",
    "linux": {
      "deb": {
        "section": "education",
        "priority": "optional",
        "files": {
          "/usr/share/doc/monkeytype-offline/LICENSE": "../LICENSE",
          "/usr/share/doc/monkeytype-offline/NOTICE.md": "../NOTICE.md",
          "/usr/share/doc/monkeytype-offline/README.md": "../README.md"
        }
      }
    }
  }
}
