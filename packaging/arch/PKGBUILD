pkgname=monkeytype-offline
pkgver=1.0.3
pkgrel=1
pkgdesc="Unofficial offline-focused Linux desktop edition of Monkeytype"
arch=('x86_64')
url="https://github.com/MStonehouse/monkeytypeOfflineLinux"
license=('GPL-3.0-only')
depends=('gtk3' 'webkit2gtk-4.1' 'libayatana-appindicator' 'librsvg')
options=('!strip')
source=()
sha256sums=()

package() {
  local root="${startdir}/../.."
  install -Dm755 "${root}/src-tauri/target/release/monkeytype-offline" \
    "${pkgdir}/usr/bin/monkeytype-offline"
  install -Dm644 "${root}/src-tauri/icons/icon.png" \
    "${pkgdir}/usr/share/icons/hicolor/512x512/apps/monkeytype-offline.png"
  install -Dm644 /dev/stdin "${pkgdir}/usr/share/applications/monkeytype-offline.desktop" <<'DESKTOP'
[Desktop Entry]
Name=Monkeytype Offline
Comment=Offline typing practice
Exec=monkeytype-offline
Icon=monkeytype-offline
Terminal=false
Type=Application
Categories=Education;
DESKTOP
  install -Dm644 "${root}/LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  install -Dm644 "${root}/NOTICE.md" "${pkgdir}/usr/share/doc/${pkgname}/NOTICE.md"
  install -Dm644 "${root}/README.md" "${pkgdir}/usr/share/doc/${pkgname}/README.md"
}
